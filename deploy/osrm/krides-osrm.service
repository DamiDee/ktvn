[Unit]
Description=K-Rides Nigeria OSRM road routing
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=-/usr/bin/podman rm --force --ignore krides-osrm
ExecStart=/opt/krides-osrm/run-router.sh
ExecStop=/usr/bin/podman stop --ignore --time 20 krides-osrm
ExecStopPost=-/usr/bin/podman rm --force --ignore krides-osrm
Restart=on-failure
RestartSec=10
TimeoutStartSec=90
TimeoutStopSec=35
OOMScoreAdjust=300

[Install]
WantedBy=multi-user.target
