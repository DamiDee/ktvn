# Live API integration is the default. Use demo to restore the isolated prototype.
NEXT_PUBLIC_FREE_BUSES_MODE=live

# The browser calls this directly, so it must be public and reachable from the client.
# The API must allow this app's exact origin with Access-Control-Allow-Credentials: true,
# and set its access_token / refresh_token cookies SameSite=None; Secure.
NEXT_PUBLIC_FREEBUS_API_BASE_URL=https://api.freebus.cloud/api/v1

# Complete registration JSON budget in bytes (includes Base64 files).
# Default: 2097152 (2 MiB). Set BELOW the smallest API/proxy request-body limit.
# Files are automatically reduced to 90% of this complete-body budget before sending.
# Rebuild after changes.
NEXT_PUBLIC_MAX_APPLICATION_BYTES=2097152

# Optional: your own GeoNames username with free web services enabled.
# Server-only. Without it, City uses the local Abuja list plus manual entry.
# https://www.geonames.org/login
GEONAMES_USERNAME=

# Google Maps is the map, place-search, and routing provider across the app.
# Public WEBSITE-restricted browser key, available at runtime (no rebuild required).
# This value is deliberately exposed to browsers by /api/maps/config.
GOOGLE_MAPS_BROWSER_API_KEY=
# Private server key for legacy route/distance/geocoding API endpoints.
# Restrict it to the hosting server's IP and the required Google APIs.
GOOGLE_MAPS_SERVER_API_KEY=

# Web Push (VAPID) – generate with: node scripts/generate-vapid-keys.mjs
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is sent to the browser to sign push subscriptions.
# VAPID_PRIVATE_KEY stays server-side only (never prefix with NEXT_PUBLIC_).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@k-rides.app

# Paid Rides (feature flag + data source): off | mock | api.
# Defaults to api for live deployments and mock for explicit Free Buses demo mode.
NEXT_PUBLIC_PAID_RIDES=api
# Optional override. Defaults to the Free Buses API base and shares its login cookies.
# REST base including /api/v1, e.g. https://api.freebus.cloud/api/v1
NEXT_PUBLIC_PAID_RIDES_API_BASE_URL=
# Optional socket override, e.g. wss://api.freebus.cloud/rides/ws.
# Defaults to the paid-rides REST base with /rides/ws and ws/wss protocol.
# All roles connect to this URL; driver identity comes from the authenticated cookie.
NEXT_PUBLIC_PAID_RIDES_REALTIME_URL=
# In-app chat. Leave empty until the backend has message endpoints (off in v1).
NEXT_PUBLIC_PAID_RIDES_CHAT=
# Set to "on" only after the SOS endpoint and staffed escalation/acknowledgement are verified.
NEXT_PUBLIC_PAID_RIDES_SOS_ENDPOINT=
# Paid Rides maps, place suggestions, geocoding, and road previews.
# Retained for old hosting setups; the application now always selects Google.
NEXT_PUBLIC_RIDES_MAP_PROVIDER=google
# Enable Maps JavaScript API, Places API (New), Geocoding API, and Routes API.
# Browser key: configure allowed website referrers in Google Cloud, then rebuild.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
